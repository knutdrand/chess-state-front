{
  "name": "chess-state-front",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@tanstack/react-query": "^4.29.5",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.6.8",
    "chess.js": "^1.3.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-chessboard": "4.5.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "generate-api": "npx openapi-typescript-codegen --input ./openapi.json --output ./src/api --client axios --request ./custom-request.ts",
    "dev": "npm run generate-api && vite",
    "start": "npm run dev",
    "dev:exploration-preview": "VITE_PREVIEW=true npm run dev",
    "build": "npm run generate-api && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "~6.9.0",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.25.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}

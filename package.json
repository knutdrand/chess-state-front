{
  "name": "chess-state-front",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@tanstack/react-query": "^4.29.5",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.6.8",
    "chess.js": "^1.3.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-chessboard": "4.5.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "react-scripts": "5.0.1",
    "web-vitals": "2.1.4",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "generate-api": "npx openapi-typescript-codegen --input ./openapi.json --output ./src/api --client axios --request ./custom-request.ts",
    "start": "npm run generate-api && react-scripts start",
    "build": "npm run generate-api && react-scripts build",
    "typecheck": "tsc --noEmit",
    "preview": "REACT_APP_PREVIEW=true react-scripts start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "openapi-typescript-codegen": "^0.25.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/**/*.test.{js,jsx,ts,tsx}",
      "!src/utils/testUtils.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ],
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  }
}
